{
  "name": "dom-ryadom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "refresh": "node parser/refresh.mjs",
    "refresh:all": "CIAN_ALL_CITIES=1 node parser/refresh.mjs",
    "cities": "python3 parser/discover_cities.py",
    "parse": "python3 parser/build_dataset.py",
    "parse:fixture": "python3 parser/parse_cian.py parser/fixtures/sample.html -o /tmp/dom-ryadom-fixture.json",
    "fetch": "node parser/refresh.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
